  "rule": "Art. 5(1), first subparagraph, point (bb), with Art. 5(1a) AIA; applicable from 2 December 2026 under Art. 113, third paragraph, point (a) AIA",
  "sources": [
    {"source_id": "oj-reg-2026-1744", "pinpoint": "Art. 1(7)(a): new Art. 5(1), first subparagraph, point (bb)"},
    {"source_id": "oj-reg-2026-1744", "pinpoint": "Art. 1(7)(b): new Art. 5(1a)(a)(i), (a)(ii) and (b)"},
