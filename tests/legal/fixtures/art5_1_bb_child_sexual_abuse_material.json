    {"source_id": "oj-dir-2011-93", "pinpoint": "Art. 2, points (c) and (e); Art. 5(1) ('without right')"},
    {"source_id": "consolidated-ai-act-2026-07-27", "pinpoint": "Art. 5(1)(bb), (1a); Art. 113 (cross-check)"}
  ],
  "interpretations": [
    {"id": "INT-5-deployer-route", "text": "For use, Art. 5(1a)(b) is read as replacing the system-level conditions: the use is prohibited where the deployer uses the system for the purpose of generating or manipulating the material or performance and no 'without right' defence applies."},
    {"id": "INT-5-without-right-defence", "text": "Whether a 'without right' defence applies under national law is a fact the reviewer establishes; the engine does not evaluate national law."},
    {"id": "INT-5-before-date-review", "text": "Where all elements are met and the assessment date falls before 2 December 2026, the point does not yet apply, but the result goes to review."},
    {"id": "INT-5-date-unknown-conservative", "text": "Where all elements are met but the assessment date is unknown, the engine votes the prohibited tier and routes the result to review."}
  ],
