{
  "rule": "Art. 111(4) AIA, added by Regulation (EU) 2026/1744: providers of AI systems generating synthetic audio, image, video or text content placed on the market before 2 August 2026 comply with Art. 50(2) by 2 December 2026; Art. 50 otherwise applies from 2 August 2026 (Art. 113, second paragraph AIA)",
  "sources": [
    {
      "source_id": "oj-reg-2026-1744",
      "pinpoint": "Art. 1, point (39)(b): Art. 111(4) added"
    },
    {
      "source_id": "oj-reg-2024-1689",
      "pinpoint": "Art. 50(1), (2); Art. 113, second paragraph"
    },
    {
      "source_id": "consolidated-ai-act-2026-07-27",
      "pinpoint": "Art. 50(2); Art. 111(4) (cross-check only)"
    }
  ],
  "interpretations": [
    {
      "id": "C9-dates",
      "text": "'Comply by' a date is read as: the obligations apply to the legacy model or system from that date inclusive. 'Before' a cut-off excludes the cut-off date. Art. 111(4) is triggered by placing on the market only. An unknown placing date leaves the application date open (null) and goes to review, unless the assessment date falls on or after both possible dates."
    }
  ],
  "base_profile": {
    "name": "Synthetic text generator",
    "roles": [
      "provider"
    ],
    "generates_synthetic_content": true,
    "intimate_imagery": {
      "generates_material": false,
      "manipulates_material_increasing_exposure": false
    },
    "child_sexual_abuse_material": {
      "generates_or_manipulates": false
    }
  },
