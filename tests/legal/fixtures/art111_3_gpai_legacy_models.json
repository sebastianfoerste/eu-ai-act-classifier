{
  "rule": "Art. 111(3) AIA: providers of general-purpose AI models placed on the market before 2 August 2025 comply by 2 August 2027; Chapter V applies from 2 August 2025 (Art. 113, third paragraph, point (b) AIA)",
  "sources": [
    {
      "source_id": "oj-reg-2024-1689",
      "pinpoint": "Art. 111(3); Art. 113, third paragraph, point (b)"
    },
    {
      "source_id": "consolidated-ai-act-2026-07-27",
      "pinpoint": "Art. 111(3), not amended by Regulation (EU) 2026/1744 (cross-check only)"
    }
  ],
  "interpretations": [
    {
      "id": "C9-dates",
      "text": "'Comply by' a date is read as: the obligations apply to the legacy model or system from that date inclusive. 'Before' a cut-off excludes the cut-off date. Art. 111(4) is triggered by placing on the market only. An unknown placing date leaves the application date open (null) and goes to review, unless the assessment date falls on or after both possible dates."
    }
  ],
  "base_profile": {
    "name": "Synthetic base model",
    "roles": [
      "gpai_provider"
    ],
    "is_gpai_model": true,
    "training_flops": 1e+24
  },
