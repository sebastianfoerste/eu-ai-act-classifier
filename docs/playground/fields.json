{
  "version": "0.2.0",
  "groups": [
    {
      "label": "System",
      "fields": [
        {
          "name": "name",
          "type": "string",
          "default": null,
          "hint": "Required. Shown as the system name in the report."
        },
        {
          "name": "description",
          "type": "string",
          "default": "",
          "hint": ""
        },
        {
          "name": "roles",
          "type": "list",
          "default": [
            "provider"
          ],
          "hint": "Operator roles under the AIA. A single company often holds several.",
          "options": [
            {
              "value": "provider",
              "label": "Provider"
            },
            {
              "value": "deployer",
              "label": "Deployer"
            },
            {
              "value": "importer",
              "label": "Importer"
            },
            {
              "value": "distributor",
              "label": "Distributor"
            },
            {
              "value": "authorized_representative",
              "label": "Authorized representative"
            },
            {
              "value": "gpai_provider",
              "label": "Gpai provider"
            }
          ]
        },
        {
          "name": "purpose",
          "type": "string",
          "default": "",
          "hint": ""
        },
        {
          "name": "sector",
          "type": "string",
          "default": "",
          "hint": ""
        }
      ]
    },
    {
      "label": "Scope and intake",
      "fields": [
        {
          "name": "is_ai_system",
          "type": "boolean or null",
          "default": true,
          "hint": "Treated as an in-scope AI system unless set otherwise."
        },
        {
          "name": "intended_purpose_source",
          "type": "string",
          "default": "",
          "hint": ""
        },
        {
          "name": "eu_nexus",
          "type": "boolean or null",
          "default": true,
          "hint": ""
        },
        {
          "name": "excluded_use_flags",
          "type": "list",
          "default": [],
          "hint": "Scope exclusions or carve-outs that need visible review.",
          "options": [
            {
              "value": "military_defence_national_security",
              "label": "Military defence national security"
            },
            {
              "value": "research_development_testing",
              "label": "Research development testing"
            },
            {
              "value": "personal_non_professional",
              "label": "Personal non professional"
            },
            {
              "value": "free_open_source",
              "label": "Free open source"
            }
          ]
        },
        {
          "name": "assessment_date",
          "type": "string or null",
          "default": null,
          "hint": "ISO date of the placing on the market, putting into service or use under assessment. Selects the rules in force (Art. 5(1)(ba) and (bb) from 2026-12-02); null leaves date-dependent results UNKNOWN."
        },
        {
          "name": "placing_on_market_date",
          "type": "string or null",
          "default": null,
          "hint": "ISO date. Dates GPAI obligations (Art. 111(3) AIA) and Art. 50(2) (Art. 111(4) AIA); null leaves those dates UNKNOWN."
        },
        {
          "name": "putting_into_service_date",
          "type": "string or null",
          "default": null,
          "hint": "ISO date, for transitional status."
        },
        {
          "name": "significant_change_after_application_date",
          "type": "boolean or null",
          "default": null,
          "hint": ""
        },
        {
          "name": "public_authority_use",
          "type": "boolean",
          "default": false,
          "hint": ""
        },
        {
          "name": "deployer_public_law_body",
          "type": "boolean or null",
          "default": null,
          "hint": "Art. 27 AIA: fundamental rights impact assessment."
        },
        {
          "name": "deployer_private_public_service",
          "type": "boolean or null",
          "default": null,
          "hint": "Art. 27 AIA: fundamental rights impact assessment."
        },
        {
          "name": "provider_established_outside_eu",
          "type": "boolean",
          "default": false,
          "hint": "Art. 22 AIA: authorised representative."
        },
        {
          "name": "has_authorised_representative",
          "type": "boolean or null",
          "default": null,
          "hint": "Art. 22 AIA."
        },
        {
          "name": "substantially_modifies_system",
          "type": "boolean",
          "default": false,
          "hint": "Value-chain obligations."
        },
        {
          "name": "puts_name_or_trademark_on_system",
          "type": "boolean",
          "default": false,
          "hint": "Value-chain obligations."
        }
      ]
    },
    {
      "label": "General-purpose AI model (Chapter V AIA)",
      "fields": [
        {
          "name": "is_gpai_model",
          "type": "boolean",
          "default": false,
          "hint": ""
        },
        {
          "name": "training_flops",
          "type": "number or null",
          "default": null,
          "hint": "Cumulative training compute in FLOP; drives Art. 51(2) AIA."
        },
        {
          "name": "gpai_systemic_risk_designated",
          "type": "boolean",
          "default": false,
          "hint": "Commission designation under Art. 51(1)(b) AIA."
        }
      ]
    },
    {
      "label": "Prohibited-practice screens (Art. 5(1) AIA)",
      "fields": [
        {
          "name": "prohibited_practices",
          "type": "list",
          "default": [],
          "hint": "Keyed to the letters (a) to (h) of Art. 5(1) AIA.",
          "options": [
            {
              "value": "5.1.a",
              "label": "Subliminal manipulation"
            },
            {
              "value": "5.1.b",
              "label": "Exploits vulnerabilities"
            },
            {
              "value": "5.1.c",
              "label": "Social scoring"
            },
            {
              "value": "5.1.d",
              "label": "Predictive policing individual"
            },
            {
              "value": "5.1.e",
              "label": "Facial scraping"
            },
            {
              "value": "5.1.f",
              "label": "Emotion recognition work education"
            },
            {
              "value": "5.1.g",
              "label": "Biometric categorisation sensitive"
            },
            {
              "value": "5.1.h",
              "label": "Realtime remote biometric id"
            }
          ]
        },
        {
          "name": "intimate_imagery",
          "type": "object or null",
          "default": null,
          "hint": "Art. 5(1)(ba), (1a) and (1b) AIA, from 2026-12-02: facts on generating or manipulating intimate imagery of identifiable persons without consent. Each fact is true, false or null (not established).",
          "keys": [
            "intended_purpose",
            "foreseeable_and_reproducible",
            "adequate_safeguards",
            "deployer_uses_for_that_purpose",
            "generates_material",
            "manipulates_material_increasing_exposure",
            "consent_ensured"
          ]
        },
        {
          "name": "child_sexual_abuse_material",
          "type": "object or null",
          "default": null,
          "hint": "Art. 5(1)(bb) and (1a) AIA, from 2026-12-02: facts on material within Art. 2(c) and (e) of Directive 2011/93/EU. Each fact is true, false or null.",
          "keys": [
            "intended_purpose",
            "foreseeable_and_reproducible",
            "adequate_safeguards",
            "deployer_uses_for_that_purpose",
            "generates_or_manipulates",
            "without_right_defence_applies"
          ]
        }
      ]
    },
    {
